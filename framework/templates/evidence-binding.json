{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/evidence-binding.json",
  "title": "AGCP Evidence Binding",
  "type": "object",
  "required": [
    "evidence_binding_id",
    "proposal_id",
    "governance_evidence_refs",
    "evidence_qualification",
    "integrity_protection"
  ],
  "properties": {
    "evidence_binding_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "governance_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_type", "evidence_digest", "authority"],
        "properties": {
          "evidence_id": { "type": "string", "format": "uuid" },
          "evidence_type": {
            "type": "string",
            "enum": [
              "FAIRNESS_ASSESSMENT",
              "ROBUSTNESS_TEST",
              "SECURITY_AUDIT",
              "PRIVACY_IMPACT",
              "CANONICAL_STATE_QUALIFICATION",
              "AUTHORITY_LINEAGE",
              "DELEGATION_CHAIN",
              "INVARIANT_EVALUATION",
              "CONSTRAINT_EVALUATION",
              "EXCEPTION_EVALUATION",
              "HITL_APPROVAL",
              "RISK_ASSESSMENT",
              "DPIA",
              "INCIDENT_REPORT",
              "ROOT_CAUSE_ANALYSIS"
            ]
          },
          "evidence_digest": {
            "type": "object",
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "type": "string", "enum": ["SHA-256", "BLAKE2B-256"] },
              "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "authority": { "type": "string", "format": "uuid" },
          "qualification": {
            "type": "object",
            "required": ["fresh", "provenance_verified", "integrity_verified", "authority_verified"],
            "properties": {
              "fresh": { "type": "boolean" },
              "provenance_verified": { "type": "boolean" },
              "integrity_verified": { "type": "boolean" },
              "authority_verified": { "type": "boolean" }
            }
          }
        }
      }
    },
    "evidence_qualification": {
      "type": "object",
      "required": ["qualified", "qualified_at", "qualified_by"],
      "properties": {
        "qualified": { "type": "boolean" },
        "qualified_at": { "type": "string", "format": "date-time" },
        "qualified_by": { "type": "string", "format": "uuid" },
        "failures": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "integrity_protection": {
      "type": "object",
      "required": ["algorithm", "binding_digest"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["SHA-256", "BLAKE2B-256"] },
        "binding_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}