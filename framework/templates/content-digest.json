{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/content-digest.json",
  "title": "AGCP Content Digest Contract",
  "type": "object",
  "required": [
    "algorithm",
    "value"
  ],
  "properties": {
    "algorithm": {
      "type": "string",
      "enum": [
        "SHA-256",
        "BLAKE2B-256",
        "SHA-384",
        "SHA-512",
        "BLAKE2B-512"
      ],
      "description": "Cryptographic hash algorithm"
    },
    "value": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$|^[a-f0-9]{96}$|^[a-f0-9]{128}$",
      "description": "Lowercase hexadecimal digest value. Length must match algorithm: 64 chars for SHA-256/BLAKE2B-256, 96 for SHA-384, 128 for SHA-512/BLAKE2B-512"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "algorithm": "SHA-256",
      "value": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456"
    },
    {
      "algorithm": "BLAKE2B-256",
      "value": "f6e5d4c3b2a10987654321098765432109876543210fedcba9876543210fedcba"
    },
    {
      "algorithm": "SHA-384",
      "value": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"
    },
    {
      "algorithm": "SHA-512",
      "value": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"
    }
  ]
}